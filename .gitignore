# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# convex local deployment state (not the generated types, which are committed)
.convex/

# python swarm service
__pycache__/
*.py[cod]
.venv/

# local agent settings
.claude/

# build notes and agent instructions, kept on this machine only
AGENTS.md
CLAUDE.md
BUILD_LOG.md
BUILD_RECORD.md
HOW-IT-WORKS.md

# typescript
*.tsbuildinfo
next-env.d.ts

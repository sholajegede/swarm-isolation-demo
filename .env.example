# Copy to .env.local and fill in. Never commit .env.local.

# --- Isolation mode -----------------------------------------------------
# shared | per-org. Decided by the deployment, never by a worker or a browser.
# Unset or unrecognised resolves to per-org, the enforcing mode.
ISOLATION_MODE=per-org

# --- Convex -------------------------------------------------------------
# Both are written for you by `npx convex dev`.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# --- Kinde: token verification ------------------------------------------
# Your Kinde domain, no trailing slash, e.g. https://example.kinde.com
KINDE_ISSUER_URL=
# The audience of the demo API registered in Kinde.
KINDE_AUDIENCE=

# --- Kinde: Management API (provisioning + the suspension kill switch) ----
KINDE_MGMT_CLIENT_ID=
KINDE_MGMT_CLIENT_SECRET=

# --- Kimi K3 ------------------------------------------------------------
# The model id is configuration, never a constant in code. Pinned ids go 404.
KIMI_MODEL=
# Moonshot or OpenRouter, whichever key you hold.
KIMI_BASE_URL=
KIMI_API_KEY=
# kimi-k3 defaults to maximum reasoning effort, which is slow and costly for
# work this small. low | high | max. Defaults to low.
KIMI_REASONING_EFFORT=low

# --- Swarm process -------------------------------------------------------
# The Python interpreter the console launches runs with. Relative to the repo.
SWARM_PYTHON=.venv/bin/python
